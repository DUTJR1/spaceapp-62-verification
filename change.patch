@@ -0,0 +1,26 @@
+import { randomUUID } from "node:crypto";
+import { resolve, sep } from "node:path";
+import { InMemoryStreamingBotRepository, InMemoryStreamingRepository } from "@space/db";
+import type { InMemorySpaceStore } from "@space/runtime";
+import { StreamingCredentialStore } from "../../src/streaming-credential-store.js";
+import { StreamingService } from "../../src/streaming-service.js";
+import { StreamingBotService } from "../../src/streaming-bot-service.js";
+
+/** Memory-route tests still use the real streaming services, with no provider.
+ * The production credential store requires a slash-root path, including on
+ * Windows. Keep its unused data path inside this test checkout's current drive.
+ * Memory tests never read or write credentials, so do not invoke the production
+ * Unix-only temporary-directory cleanup guard when closing the app.
+ */
+export function memoryGraphStreamingFixture(store: InMemorySpaceStore) {
+  const workspace = resolve(process.cwd());
+  const nativeRoot = resolve(workspace, ".memory-graph-test-temp", randomUUID());
+  const root = process.platform === "win32" ? nativeRoot.replace(/^[A-Za-z]:/, "").replaceAll("\\", "/") : nativeRoot;
+  const resolvedRoot = resolve(root);
+  if (!resolvedRoot.startsWith(workspace + sep)) throw new Error("The memory test's temporary credentials must stay inside its checkout.");
+  const repository = new InMemoryStreamingRepository();
+  return {
+    streamingService: new StreamingService({ repository, credentialStore: new StreamingCredentialStore(root), store, cleanupCredentialRootOnDispose: false }),
+    streamingBotService: new StreamingBotService({ botRepository: new InMemoryStreamingBotRepository(), streamingRepository: repository, store, youtubeDailyBudget: 8000 })
+  };
+}
