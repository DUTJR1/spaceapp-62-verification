@@ -0,0 +1,36 @@
+import { MEMORY_NODE_CORE } from "./memory-graph-picking.js";
+
+export const MEMORY_GRAPH_LABEL_BUDGET = 128;
+
+/** Bounded LOD selection; core/source priority is prepared once, not sorted per frame. */
+export function selectMemoryGraphLabelIndices(flags: Uint8Array, sourceIndices: Uint32Array, zoom: number, focusIndex = -1, budget = MEMORY_GRAPH_LABEL_BUDGET): number[] {
+  const limit = Math.max(0, Math.min(MEMORY_GRAPH_LABEL_BUDGET, Math.floor(budget)));
+  const result: number[] = [], seen = new Set<number>();
+  const add = (index: number) => {
+    if (index < 0 || index >= flags.length || seen.has(index) || result.length >= limit) return;
+    result.push(index); seen.add(index);
+  };
+  if (limit === 0) return result;
+  add(focusIndex);
+  // Core entries precede other sources. Even malformed metadata cannot cause an
+  // unbounded scan: only the first budget entries are examined for this pass.
+  for (let i = 0; i < Math.min(sourceIndices.length, limit); i++) {
+    const index = sourceIndices[i]!;
+    if (flags[index]! & MEMORY_NODE_CORE) add(index);
+  }
+  const sourceQuota = zoom < 1.6 ? limit : Math.min(limit, result.length + Math.ceil((limit - result.length) * 0.75));
+  const sourceStride = Math.max(1, Math.ceil(sourceIndices.length / Math.max(1, sourceQuota - result.length)));
+  for (let i = 0; i < sourceIndices.length && result.length < sourceQuota; i += sourceStride) add(sourceIndices[i]!);
+  if (zoom >= 1.6) {
+    const remaining = limit - result.length, stride = Math.max(1, Math.ceil(flags.length / Math.max(1, remaining)));
+    for (let i = 0, attempts = 0; i < flags.length && result.length < limit && attempts < limit; i += stride, attempts++) add(i);
+  }
+  return result;
+}
+
+export interface MemoryGraphLabelBox { x: number; y: number; width: number }
+
+export function memoryGraphLabelFits(box: MemoryGraphLabelBox, placed: readonly MemoryGraphLabelBox[], width: number, height: number): boolean {
+  return box.x >= 0 && box.x + box.width <= width && box.y >= 14 && box.y <= height - 5
+    && !placed.some(other => Math.abs(other.y - box.y) < 16 && box.x < other.x + other.width + 5 && box.x + box.width + 5 > other.x);
+}
