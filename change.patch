+import type { ListMemoryGraphOverviewQuery, MemoryGraphEdge, MemoryGraphNode, MemoryGraphNodeDetail, MemoryGraphOverviewPayload } from "@space/contracts";
+import type { createMemoryAtlas, MemoryAtlasPosition } from "./memory-atlas.js";
+
+/** All indices use the prepared atlas.nodes order, for the lifetime of one job. */
+export interface PreparedMemoryGraphScene {
+  nodeIds: string[];
+  labels: string[];
+  /** SOURCE = 1, CORE = 2. */
+  flags: Uint8Array;
+  /** Three normalized RGB channels per node. */
+  colors: Float32Array;
+  /** Interleaved source/target node indices, two entries per edge. */
+  edgeIndices: Uint32Array;
+  /** DERIVED_FROM = 1. */
+  edgeFlags: Uint8Array;
+  /** All SOURCE indices, CORE first then stable input order. */
+  sourceIndices: Uint32Array;
+  /** Undirected CSR adjacency, including each incident edge once per endpoint. */
+  adjacencyOffsets: Uint32Array;
+  adjacencyNodes: Uint32Array;
+}
+
+export type MemoryGraphSource =
+  | { kind: "api"; url: string }
+  | { kind: "synthetic"; size: 2000 | 10000 | 50000; seed: number; query?: Partial<ListMemoryGraphOverviewQuery> }
+  | { kind: "inline"; data: MemoryGraphOverviewPayload };
+export type GraphSource = MemoryGraphSource;
+
+export type MemoryGraphAtlasMeta = Pick<ReturnType<typeof createMemoryAtlas>, "groups" | "topics" | "explicitCount" | "semanticCount">;
+export type MemoryGraphTimings = Record<string, number>;
+
+export type MemoryGraphDataRequest =
+  | { type: "load"; jobId: number; source: MemoryGraphSource; layoutPort?: MessagePort }
+  | { type: "ack"; jobId: number; sequence: number }
+  | { type: "detail"; jobId: number; nodeId: string; detailRequestId?: number };
+
+export type MemoryGraphDataResponse =
+  | { type: "meta"; jobId: number; overview: Omit<MemoryGraphOverviewPayload, "nodes" | "edges">; atlas: MemoryGraphAtlasMeta; nodeCount: number; edgeCount: number; memoryCount: number; sourceLinkCount: number; decodedBytes: number; timings: MemoryGraphTimings }
+  | { type: "nodes"; jobId: number; sequence: number; offset: number; nodes: MemoryGraphNode[]; atlasPositions: Array<[string, MemoryAtlasPosition]> }
+  | { type: "edges"; jobId: number; sequence: number; offset: number; edges: MemoryGraphEdge[] }
+  | { type: "prepared"; jobId: number; scene: PreparedMemoryGraphScene; decodedBytes: number; timings: MemoryGraphTimings }
+  | { type: "complete"; jobId: number }
+  | { type: "detail"; jobId: number; nodeId: string; detail: MemoryGraphNodeDetail; detailRequestId?: number }
+  | { type: "error"; jobId: number; message: string; status?: number; code?: string; requestId?: string; detailRequestId?: number };
+
+/** Compact layout input contains every field used by the deterministic layout. */
+export type Memory3DLayoutNode = Pick<MemoryGraphNode, "id" | "type" | "label" | "sourcePath">;
+export type Memory3DLayoutEdge = Pick<MemoryGraphEdge, "id" | "source" | "target" | "type">;
+export type Memory3DLayoutRequest = { type: "layout"; jobId: number; nodes: Memory3DLayoutNode[]; edges: Memory3DLayoutEdge[] };
+export type MemoryLayoutWorkerRequest =
+  | { type: "connect"; jobId: number; port: MessagePort }
+  | Memory3DLayoutRequest
+  | { type: "cancel"; jobId: number };
+
+/** xyz uses input node order; snapshots never replace the internal Float64 state. */
+export interface Memory3DLayoutFrame {
+  type: "layout";
+  jobId: number;
+  sequence: number;
+  iteration: number;
+  totalIterations: number;
+  complete: boolean;
+  xyz: Float32Array;
+  extent: number;
+  volumeRatio: number;
+  approximate: boolean;
+  diagnostics?: { initializationMs: number; lastStepMs: number; maxCellOccupancy: number; pairInteractions: number; aggregateInteractions: number };
+}
+
+export type MemoryLayoutWorkerResponse = Memory3DLayoutFrame
+  | { type: "error"; jobId: number; message: string };
