+import { useCallback, useEffect, useRef, useState } from "react";
+import type { MemoryGraphNodeDetail } from "@space/contracts";
+import { api } from "../../api.js";
+import type { MemoryGraphFallbackData } from "./MemoryGraph3D.js";
+import { isMemoryCoreLabel } from "./memory-graph-visuals.js";
+import type { Memory3DLayoutFrame, MemoryGraphDataResponse, MemoryLayoutWorkerResponse, PreparedMemoryGraphScene } from "./memory-graph-scene.js";
+
+type Meta = Extract<MemoryGraphDataResponse, { type: "meta" }>;
+type PendingDetail = { resolve: (detail: MemoryGraphNodeDetail) => void; reject: (error: Error) => void };
+const emptyFallback = (): MemoryGraphFallbackData => ({ nodes: [], edges: [], positions: new Map() });
+
+/** Large payloads stay in the data worker. React receives compact render buffers,
+ * progressive coordinates and a small, explicit Canvas fallback sample only. */
+export function useMemoryGraph3DData(enabled: boolean, query: string, limit: 2000 | 10000 | 50000) {
+  const [scene, setScene] = useState<PreparedMemoryGraphScene | null>(null);
+  const [layoutFrame, setLayoutFrame] = useState<Memory3DLayoutFrame | null>(null);
+  const [fallbackData, setFallbackData] = useState<MemoryGraphFallbackData>(emptyFallback);
+  const [meta, setMeta] = useState<Meta | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [diagnostics, setDiagnostics] = useState<{ jobId: number; loadStartedAt: number; decodedBytes?: number; timings?: Record<string, number> } | null>(null);
+  const nextJob = useRef(0);
+  const workerRef = useRef<{ worker: Worker; jobId: number } | null>(null);
+  const nextDetail = useRef(0);
+  const pending = useRef(new Map<number, PendingDetail>());
+
+  useEffect(() => {
+    if (!enabled || typeof Worker === "undefined") return;
+    const jobId = ++nextJob.current;
+    let active = true, prepared = false, latestLayout: Memory3DLayoutFrame | null = null;
+    const loadStartedAt = performance.now();
+    const dataWorker = new Worker(new URL("./memory-graph-data.worker.ts", import.meta.url), { type: "module" });
+    const layoutWorker = new Worker(new URL("./memory-network-layout.worker.ts", import.meta.url), { type: "module" });
+    const channel = new MessageChannel();
+    const fallback = emptyFallback();
+    const fallbackIds = new Set<string>();
+    const replaceable: number[] = [];
+    setScene(null); setLayoutFrame(null); setMeta(null); setFallbackData(emptyFallback());
+    setLoading(true); setError(null); setDiagnostics({ jobId, loadStartedAt });
+    workerRef.current = { worker: dataWorker, jobId };
+    const fail = (message: string) => { if (active) { setError(message); setLoading(false); } };
+    dataWorker.onmessage = (event: MessageEvent<MemoryGraphDataResponse>) => {
+      const message = event.data;
+      if (!active || message.jobId !== jobId) return;
+      switch (message.type) {
+        case "meta": setMeta(message); break;
+        case "nodes": {
+          for (const node of message.nodes) {
+            let index = fallback.nodes.length;
+            if (index >= 2000) {
+              if (node.type !== "SOURCE") continue;
+              const replacement = replaceable.pop();
+              index = replacement ?? -1;
+              if (index < 0 && isMemoryCoreLabel(node.label)) {
+                for (let candidate = fallback.nodes.length - 1; candidate >= 0; candidate--) {
+                  if (!isMemoryCoreLabel(fallback.nodes[candidate]!.label)) { index = candidate; break; }
+                }
+              }
+              if (index < 0) continue;
+              const previous = fallback.nodes[index]!;
+              fallbackIds.delete(previous.id); fallback.positions.delete(previous.id);
+            }
+            fallback.nodes[index] = node; fallbackIds.add(node.id);
+            if (node.type !== "SOURCE") replaceable.push(index);
+          }
+          for (const [id, position] of message.atlasPositions) if (fallbackIds.has(id)) fallback.positions.set(id, position);
+          dataWorker.postMessage({ type: "ack", jobId, sequence: message.sequence });
+          break;
+        }
+        case "edges": {
+          for (const edge of message.edges) {
+            if (fallback.edges.length >= 6000) break;
+            if (fallbackIds.has(edge.source) && fallbackIds.has(edge.target)) fallback.edges.push(edge);
+          }
+          dataWorker.postMessage({ type: "ack", jobId, sequence: message.sequence });
+          break;
+        }
+        case "prepared":
+          prepared = true;
+          setFallbackData(fallback); setScene(message.scene);
+          if (latestLayout) setLayoutFrame(latestLayout);
+          setDiagnostics({ jobId, loadStartedAt, decodedBytes: message.decodedBytes, timings: message.timings });
+          break;
+        case "complete": setLoading(false); break;
+        case "detail": {
+          const request = message.detailRequestId;
+          if (request !== undefined) { pending.current.get(request)?.resolve(message.detail); pending.current.delete(request); }
+          break;
+        }
+        case "error": {
+          if (message.detailRequestId !== undefined) {
+            pending.current.get(message.detailRequestId)?.reject(new Error(message.message));
+            pending.current.delete(message.detailRequestId);
+          } else fail(message.message);
+          break;
+        }
+      }
+    };
+    layoutWorker.onmessage = (event: MessageEvent<MemoryLayoutWorkerResponse>) => {
+      const message = event.data;
+      if (!active || message.jobId !== jobId) return;
+      if (message.type === "error") { fail(message.message); return; }
+      if (latestLayout && message.sequence <= latestLayout.sequence) return;
+      latestLayout = message;
+      if (prepared) setLayoutFrame(message);
+    };
+    dataWorker.onerror = event => {
+      const message = `Memory data could not be loaded: ${event.message || "worker unavailable"}`;
+      fail(message);
+      if (workerRef.current?.jobId === jobId) workerRef.current = null;
+      for (const request of pending.current.values()) request.reject(new Error(message));
+      pending.current.clear();
+    };
+    layoutWorker.onerror = event => fail(`Memory layout could not be calculated: ${event.message || "worker unavailable"}`);
+    layoutWorker.postMessage({ type: "connect", jobId, port: channel.port1 }, [channel.port1]);
+    void api.memoryGraphOverviewSource({ q: query || undefined, month: "all", relationMode: "RELATIONS", limit })
+      .then(source => { if (active) dataWorker.postMessage({ type: "load", jobId, source, layoutPort: channel.port2 }, [channel.port2]); })
+      .catch(caught => fail(caught instanceof Error ? caught.message : "Memory could not be loaded."));
+    return () => {
+      active = false; dataWorker.terminate(); layoutWorker.terminate(); channel.port1.close(); channel.port2.close();
+      if (workerRef.current?.jobId === jobId) workerRef.current = null;
+      for (const request of pending.current.values()) request.reject(new Error("The memory view changed."));
+      pending.current.clear();
+    };
+  }, [enabled, query, limit]);
+
+  const requestDetail = useCallback((nodeId: string): Promise<MemoryGraphNodeDetail> => {
+    const job = workerRef.current;
+    if (!job) return Promise.reject(new Error("The memory graph is not available."));
+    const detailRequestId = ++nextDetail.current;
+    return new Promise((resolve, reject) => {
+      pending.current.set(detailRequestId, { resolve, reject });
+      job.worker.postMessage({ type: "detail", jobId: job.jobId, nodeId, detailRequestId });
+    });
+  }, []);
+  return { scene, layoutFrame, fallbackData, meta, loading, error, diagnostics, requestDetail };
+}
