+  if (!labels) throw new Error("The graph label canvas is unavailable");
+  const count = scene.nodeIds.length, edgeCount = scene.edgeIndices.length / 2;
+  if (scene.flags.length !== count || scene.labels.length !== count || scene.colors.length !== count * 3 || !Number.isInteger(edgeCount)
+    || scene.edgeFlags.length !== edgeCount || scene.adjacencyOffsets.length !== count + 1) throw new Error("Invalid prepared graph buffers");
+  const buffers: WebGLBuffer[] = [], vaos: WebGLVertexArrayObject[] = [], programs: WebGLProgram[] = [];
+  let disposed = false;
+  const dispose = () => {
+    if (disposed) return;
+    disposed = true;
+    for (const buffer of buffers) gl.deleteBuffer(buffer);
+    for (const vao of vaos) gl.deleteVertexArray(vao);
+    for (const program of programs) gl.deleteProgram(program);
+    labels.clearRect(0, 0, labelCanvas.width, labelCanvas.height);
+  };
+  const buffer = () => { const value = gl.createBuffer(); if (!value) throw new Error("Cannot allocate graph buffer"); buffers.push(value); return value; };
+  const vao = () => { const value = gl.createVertexArray(); if (!value) throw new Error("Cannot allocate graph vertex array"); vaos.push(value); return value; };
+  const compile = (type: number, source: string) => {
+    const shader = gl.createShader(type);
+    if (!shader) throw new Error("Cannot allocate graph shader");
+    gl.shaderSource(shader, source); gl.compileShader(shader);
+    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) { const error = gl.getShaderInfoLog(shader); gl.deleteShader(shader); throw new Error(error || "Graph shader compilation failed"); }
+    return shader;
+  };
