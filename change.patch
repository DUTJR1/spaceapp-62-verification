+// @vitest-environment node
+import { describe, expect, it, vi } from "vitest";
+
+describe("memory data worker CSP bootstrap", () => {
+  it("validates real contracts without a document or a Function-constructor probe", async () => {
+    expect(typeof document).toBe("undefined");
+    const host = globalThis as typeof globalThis & { __zod_globalConfig?: Record<string, unknown> };
+    const config = host.__zod_globalConfig ??= {};
+    const previousJitless = config.jitless;
+    config.jitless = false;
+    let probes = 0;
+    const OriginalFunction = globalThis.Function;
+    const blocked = new Proxy(OriginalFunction, {
+      apply() { probes++; throw new Error("Function construction is forbidden by worker CSP."); },
+      construct() { probes++; throw new Error("Function construction is forbidden by worker CSP."); }
+    });
+    vi.stubGlobal("Function", blocked);
+    try {
+      await import("../src/features/memory-workspace/memory-graph-worker-csp.js");
+      expect(config.jitless).toBe(true);
+      const { memoryGraphOverviewPayloadSchema } = await import("@space/contracts");
+      const parsed = memoryGraphOverviewPayloadSchema.parse({
+        version: 1, generatedAt: "2026-07-18T12:00:00.000Z", sourceHash: "a".repeat(64), isStale: false,
+        summary: { sourceCount: 0, recordCount: 0, nodeCount: 0, edgeCount: 0, issueCount: 0 },
+        nodes: [], edges: [], filters: { q: null, nodeType: null, scope: null, roomId: null, sourcePath: null, lifecycleStatus: null, relationMode: "RELATIONS" },
+        totalMatchingNodes: 0, totalMatchingEdges: 0, truncated: false
+      });
+      expect(parsed.nodes).toHaveLength(0);
+      expect(probes).toBe(0);
+    } finally {
+      vi.unstubAllGlobals();
+      if (previousJitless === undefined) delete config.jitless;
+      else config.jitless = previousJitless;
+    }
+  });
+});
diff --git a/apps/web/tests/memory-layout-worker.test.ts b/apps/web/tests/memory-layout-worker.test.ts
new file mode 100644
index 0000000..691aab7
--- /dev/null
+++ b/apps/web/tests/memory-layout-worker.test.ts
@@ -0,0 +1,70 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { Memory3DLayoutFrame, MemoryLayoutWorkerResponse } from "../src/features/memory-workspace/memory-graph-scene.js";
+
+afterEach(() => { vi.useRealTimers(); vi.unstubAllGlobals(); vi.resetModules(); });
+
+async function workerHarness() {
+  const messages: MemoryLayoutWorkerResponse[] = [];
+  const scope = {
+    onmessage: (_event: { data: unknown }) => {},
+    postMessage: (message: MemoryLayoutWorkerResponse) => { messages.push(message); }
+  };
+  vi.stubGlobal("self", scope);
+  await import("../src/features/memory-workspace/memory-network-layout.worker.js");
+  return { scope, messages };
+}
+
+const request = {
+  type: "layout", jobId: 11,
+  nodes: [{ id: "root", label: "space.md", type: "SOURCE", sourcePath: "/space.md" }, { id: "memory", label: "Memory", type: "MEMORY", sourcePath: "/space.md" }],
+  edges: [{ id: "edge", type: "CONTAINS", source: "root", target: "memory" }]
+} as const;
+
+describe("3D layout worker protocol", () => {
+  it("publishes usable initial coordinates before completing the layout", async () => {
+    vi.useFakeTimers();
+    const { scope, messages } = await workerHarness();
+    scope.onmessage({ data: request });
+    const initial = messages[0] as Memory3DLayoutFrame;
+    expect(initial).toMatchObject({ type: "layout", jobId: 11, sequence: 0, iteration: 0, complete: false, approximate: false });
+    expect(initial.xyz.length).toBe(6);
+    await vi.runAllTimersAsync();
+    const final = messages.at(-1) as Memory3DLayoutFrame;
+    expect(final).toMatchObject({ type: "layout", jobId: 11, iteration: 180, complete: true });
+    expect(final.sequence).toBeGreaterThan(0);
+    expect(final.xyz).not.toBe(initial.xyz);
+  });
+
+  it("cancels an old job between force steps", async () => {
+    vi.useFakeTimers();
+    const { scope, messages } = await workerHarness();
+    scope.onmessage({ data: request });
+    scope.onmessage({ data: { type: "cancel", jobId: 11 } });
+    await vi.runAllTimersAsync();
+    expect(messages).toHaveLength(1);
+    expect(messages[0]).toMatchObject({ iteration: 0, complete: false });
+  });
+
+  it("accepts compact input through a job-scoped MessagePort", async () => {
+    vi.useFakeTimers();
+    const { scope, messages } = await workerHarness();
+    const port = { onmessage: (_event: { data: unknown }) => {}, start: vi.fn(), close: vi.fn() };
+    scope.onmessage({ data: { type: "connect", jobId: 11, port } });
+    expect(port.start).toHaveBeenCalledOnce();
+    port.onmessage({ data: { ...request, jobId: 12 } });
+    expect(messages).toHaveLength(0);
+    port.onmessage({ data: request });
+    expect(messages[0]).toMatchObject({ jobId: 11, iteration: 0 });
+    await vi.runAllTimersAsync();
+    expect(messages.at(-1)).toMatchObject({ jobId: 11, complete: true });
+  });
+
+  it("ignores cancellation from a different job", async () => {
+    vi.useFakeTimers();
+    const { scope, messages } = await workerHarness();
+    scope.onmessage({ data: request });
+    scope.onmessage({ data: { type: "cancel", jobId: 10 } });
+    await vi.runAllTimersAsync();
+    expect(messages.at(-1)).toMatchObject({ jobId: 11, complete: true });
+  });
+});
