diff --git a/apps/web/tests/memory-3d-streaming.test.ts b/apps/web/tests/memory-3d-streaming.test.ts
new file mode 100644
index 0000000..f1aebc3
--- /dev/null
+++ b/apps/web/tests/memory-3d-streaming.test.ts
@@ -0,0 +1,81 @@
+import { describe, expect, it } from "vitest";
+import { createMemoryNetwork3DSimulation, layoutMemoryNetwork3D } from "../src/features/memory-workspace/memory-3d.js";
+import type { MemoryGraphEdge, MemoryGraphNode } from "@space/contracts";
+
+function fixture(count = 24) {
+  const nodes: MemoryGraphNode[] = [{ id: "root", label: "space.md", type: "SOURCE", sourcePath: "/docs/space.md", recordId: null }];
+  const edges: MemoryGraphEdge[] = [];
+  for (let i = 0; i < count; i++) {
+    nodes.push({ id: `memory-${i}`, label: `Memory ${i}`, type: "MEMORY", sourcePath: "/docs/space.md", recordId: String(i) });
+    edges.push({ id: `contains-${i}`, type: "CONTAINS", source: "root", target: `memory-${i}` });
+  }
+  return { nodes, edges };
+}
+
+describe("streaming 3D layout", () => {
+  it("keeps the exact small layout independent of step batch sizes", () => {
+    const { nodes, edges } = fixture();
+    const input = JSON.stringify({ nodes, edges });
+    const complete = layoutMemoryNetwork3D(nodes, edges);
+    for (const batch of [1, 7, 180]) {
+      const simulation = createMemoryNetwork3DSimulation(nodes, edges);
+      while (simulation.iteration < simulation.totalIterations) simulation.step(batch);
+      expect(simulation.approximate).toBe(false);
+      expect([...simulation.toMap()]).toEqual([...complete]);
+      expect(simulation.iteration).toBe(180);
+    }
+    expect(JSON.stringify({ nodes, edges })).toBe(input);
+  });
+
+  it("uses the input node order for transferable snapshots and never feeds them back", () => {
+    const { nodes, edges } = fixture(8);
+    nodes.reverse();
+    const simulation = createMemoryNetwork3DSimulation(nodes, edges);
+    const initial = simulation.snapshot();
+    const exact = simulation.toMap();
+    nodes.forEach((node, i) => {
+      const point = exact.get(node.id)!;
+      expect([...initial.xyz.slice(i * 3, i * 3 + 3)]).toEqual([Math.fround(point.x), Math.fround(point.y), Math.fround(point.z)]);
+    });
+    const preserved = [...initial.xyz];
+    simulation.step(1);
+    expect([...initial.xyz]).toEqual(preserved);
+    initial.xyz.fill(0);
+    expect(simulation.snapshot().xyz.some(value => value !== 0)).toBe(true);
+    expect(simulation.toMap().get("root")).toEqual({ x: 0, y: 0, z: 0 });
+  });
+
+  it("reports dense-cell approximation explicitly and remains deterministic", () => {
+    const { nodes, edges } = fixture(80);
+    nodes.push({ id: "other-source", label: "other.md", type: "SOURCE", sourcePath: "/docs/other.md", recordId: null });
+    edges.push({ id: "ambiguous-parent", type: "CONTAINS", source: "other-source", target: "memory-0" });
+    const options = { approximate: true, maxExactCellSize: 1, iterations: 10 };
+    const left = createMemoryNetwork3DSimulation(nodes, edges, options);
+    const right = createMemoryNetwork3DSimulation([...nodes].reverse(), [...edges].reverse(), options);
+    left.step(10);
+    right.step(3); right.step(7);
+    expect(left.approximate).toBe(true);
+    expect(left.diagnostics().aggregateInteractions).toBeGreaterThan(0);
+    expect([...right.toMap()]).toEqual([...left.toMap()]);
+    const snapshot = left.snapshot();
+    expect(right.snapshot().volumeRatio).toBe(snapshot.volumeRatio);
+    expect(snapshot.xyz.every(Number.isFinite)).toBe(true);
+    expect(snapshot.volumeRatio).toBeGreaterThan(0);
+    expect(snapshot.extent).toBeGreaterThanOrEqual(60);
+  });
+
+  it("retains exact forces through 2,000 nodes and bounds empty input", () => {
+    const { nodes, edges } = fixture(2000);
+    expect(createMemoryNetwork3DSimulation(nodes.slice(0, 2000), edges).approximate).toBe(false);
+    expect(createMemoryNetwork3DSimulation(nodes, edges).approximate).toBe(true);
+    const empty = createMemoryNetwork3DSimulation([], [], { iterations: 0 });
+    expect(empty.snapshot()).toEqual({ xyz: new Float32Array(), extent: 60, volumeRatio: 0 });
+    expect(empty.step(2)).toBe(0);
+    expect(createMemoryNetwork3DSimulation([], []).totalIterations).toBe(0);
+  });
+
+  it("rejects ambiguous duplicate node indices", () => {
+    const { nodes } = fixture(0);
+    expect(() => createMemoryNetwork3DSimulation([nodes[0]!, nodes[0]!], [])).toThrow("unique node IDs");
+  });
+});
