+++ b/apps/web/src/features/memory-workspace/memory-graph-picking.ts
@@ -0,0 +1,125 @@
+import type { MemoryCamera3D } from "./memory-3d.js";
+
+export const MEMORY_NODE_SOURCE = 1;
+export const MEMORY_NODE_CORE = 2;
+
+export interface MemoryGraphViewport {
+  width: number;
+  height: number;
+  dpr: number;
+  pixelWidth: number;
+  pixelHeight: number;
+}
+
+export function memoryGraphNodeRadius(flags: number): number {
+  return flags & MEMORY_NODE_CORE ? 10 : flags & MEMORY_NODE_SOURCE ? 4.6 : 2.1;
+}
+
+/**
+ * A screen-space center grid. Every changed camera, viewport or coordinate
+ * revision rebuilds the projection before querying. No stale-camera answers.
+ * Nodes are tested by their rendered circles, with GPU depth / LEQUAL order.
+ */
+export class MemoryGraphSpatialIndex {
+  readonly screen: Float32Array;
+  readonly depth: Uint32Array;
+  readonly radii: Float32Array;
+  readonly cellSize = 16;
+  generation = 0;
+  lastCandidateCount = 0;
+  lastCellCount = 0;
+  private readonly next: Int32Array;
+  private heads = new Int32Array(0);
+  private columns = 0;
+  private rows = 0;
+  private maximumRadius = 0;
+  private state: number[] | null = null;
+  private xyz: Float32Array | null = null;
+  private viewport: MemoryGraphViewport | null = null;
+  private zBound = 1;
+  private readonly depthMaximum: number;
+
+  constructor(flags: Uint8Array, depthBits = 24) {
+    this.screen = new Float32Array(flags.length * 4);
+    this.depth = new Uint32Array(flags.length);
+    this.radii = Float32Array.from(flags, memoryGraphNodeRadius);
+    this.next = new Int32Array(flags.length);
+    this.depthMaximum = 2 ** Math.max(1, Math.min(30, depthBits)) - 1;
+  }
+
+  invalidate(): void { this.state = null; }
+
+  update(xyz: Float32Array, revision: number, extent: number, camera: MemoryCamera3D, viewport: MemoryGraphViewport): boolean {
+    if (xyz.length !== this.radii.length * 3) throw new RangeError("Coordinate count does not match prepared nodes");
+    if (![extent, camera.yaw, camera.pitch, camera.zoom, viewport.width, viewport.height, viewport.dpr, viewport.pixelWidth, viewport.pixelHeight].every(Number.isFinite)
+      || extent <= 0 || camera.zoom <= 0 || viewport.width <= 0 || viewport.height <= 0 || viewport.dpr <= 0 || viewport.pixelWidth <= 0 || viewport.pixelHeight <= 0) {
+      throw new RangeError("Invalid memory graph camera or viewport");
+    }
+    const scale = Math.min(viewport.width, viewport.height) * 0.4 / extent;
+    const state = [revision, extent, camera.yaw, camera.pitch, camera.zoom, viewport.width, viewport.height, viewport.dpr, viewport.pixelWidth, viewport.pixelHeight];
+    if (this.xyz === xyz && this.state && state.every((value, i) => value === this.state![i])) return false;
+
+    const columns = Math.max(1, Math.ceil(viewport.width / this.cellSize));
+    const rows = Math.max(1, Math.ceil(viewport.height / this.cellSize));
+    if (this.heads.length !== columns * rows) this.heads = new Int32Array(columns * rows);
+    const world = xyz, screen = this.screen, radii = this.radii, depths = this.depth, next = this.next, heads = this.heads;
+    heads.fill(-1);
+    const cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw), cp = Math.cos(camera.pitch), sp = Math.sin(camera.pitch);
+    const yx = sy * sp, yy = cp, yz = -cy * sp, zx = -sy * cp, zy = sp, zz = cy * cp;
+    const projectionNumerator = 650 * scale * camera.zoom, radiusNumerator = 650 * Math.sqrt(camera.zoom);
+    const centerX = viewport.pixelWidth / (2 * viewport.dpr), centerY = viewport.pixelHeight / (2 * viewport.dpr);
+    const width = viewport.width, height = viewport.height, lastColumn = columns - 1, lastRow = rows - 1, inverseCell = 1 / this.cellSize;
+    const zBound = extent * 4, depthMaximum = this.depthMaximum, depthScale = depthMaximum / (extent * 8), depthOffset = depthMaximum * 0.5;
+    let maximumRadius = 0;
+    for (let i = 0, input = 0, output = 0; i < radii.length; i++, input += 3, output += 4) {
+      const wx = world[input]!, wy = world[input + 1]!, wz = world[input + 2]!;
+      const x = wx * cy + wz * sy, y = wx * yx + wy * yy + wz * yz, z = wx * zx + wy * zy + wz * zz;
+      let denominator = 650 + z * scale;
+      if (denominator < 120) denominator = 120;
+      const inverseDenominator = 1 / denominator, projectedScale = projectionNumerator * inverseDenominator;
+      const sx = centerX + x * projectedScale, syScreen = centerY - y * projectedScale;
+      let radius = radii[i]! * radiusNumerator * inverseDenominator;
+      if (radius < 1) radius = 1;
+      screen[output] = sx; screen[output + 1] = syScreen; screen[output + 2] = z; screen[output + 3] = radius;
+      let depth = z * depthScale + depthOffset;
+      if (depth < 0) depth = 0; else if (depth > depthMaximum) depth = depthMaximum;
+      depths[i] = depth + 0.5;
+      const renderedRadius = radius * 1.5;
+      if (renderedRadius > maximumRadius) maximumRadius = renderedRadius;
+      if (z < -zBound || z > zBound || sx + renderedRadius < 0 || sx - renderedRadius > width || syScreen + renderedRadius < 0 || syScreen - renderedRadius > height) continue;
+      const gx = sx < 0 ? 0 : sx >= width ? lastColumn : (sx * inverseCell) | 0;
+      const gy = syScreen < 0 ? 0 : syScreen >= height ? lastRow : (syScreen * inverseCell) | 0;
+      const cell = gy * columns + gx;
+      next[i] = heads[cell]!; heads[cell] = i;
+    }
+    this.columns = columns; this.rows = rows; this.maximumRadius = maximumRadius;
+    this.xyz = xyz; this.state = state; this.viewport = viewport; this.zBound = zBound; this.generation++;
+    return true;
+  }
+
+  query(x: number, y: number, focusIndex = -1): number | null {
+    this.lastCandidateCount = 0; this.lastCellCount = 0;
+    const viewport = this.viewport;
+    if (!viewport || !Number.isFinite(x) || !Number.isFinite(y)) return null;
+    const px = Math.max(0, Math.min(viewport.pixelWidth - 1, Math.floor(x * viewport.dpr)));
+    const py = Math.max(0, Math.min(viewport.pixelHeight - 1, Math.floor(y * viewport.dpr)));
+    const qx = (px + 0.5) / viewport.dpr, qy = (py + 0.5) / viewport.dpr;
+    const minX = Math.max(0, Math.floor((qx - this.maximumRadius) / this.cellSize));
+    const maxX = Math.min(this.columns - 1, Math.floor((qx + this.maximumRadius) / this.cellSize));
+    const minY = Math.max(0, Math.floor((qy - this.maximumRadius) / this.cellSize));
+    const maxY = Math.min(this.rows - 1, Math.floor((qy + this.maximumRadius) / this.cellSize));
+    const screen = this.screen, depths = this.depth, heads = this.heads, next = this.next;
+    let best = -1, bestDepth = Infinity;
+    for (let gy = minY; gy <= maxY; gy++) for (let gx = minX; gx <= maxX; gx++) {
+      this.lastCellCount++;
+      for (let i = heads[gy * this.columns + gx]!; i !== -1; i = next[i]!) {
+        this.lastCandidateCount++;
+        const k = i * 4, dx = screen[k]! - qx, dy = screen[k + 1]! - qy;
+        const radius = screen[k + 3]! * (i === focusIndex ? 1.5 : 1), depth = depths[i]!;
+        if (dx * dx + dy * dy > radius * radius) continue;
+        if (depth < bestDepth || (depth === bestDepth && i > best)) { best = i; bestDepth = depth; }
+      }
+    }
+    return best >= 0 ? best : null;
+  }
+}
