+  if(radius>1.0)discard;
+  float alpha=1.0-smoothstep(1.0-max(fwidth(radius),0.01),1.0,radius);
+  outColor=vec4(vColor,vAlpha*alpha);
+ }
+}`;
+const edgeVertex = `#version 300 es
+precision highp float;
+layout(location=0) in vec3 aPosition;
+${projection}
+void main(){gl_Position=clip(project(aPosition),vec2(0.0));}`;
+const edgeFragment = `#version 300 es
+precision highp float;
+uniform vec3 uColor;
+out vec4 outColor;
+void main(){outColor=vec4(uColor,1.0);}`;
+
+type Program = { value: WebGLProgram; uniforms: Record<string, WebGLUniformLocation | null> };
+
+/** Native WebGL2 only. Context lifecycle and the capped Canvas2D fallback belong to the wrapper. */
+export function createMemoryGraphWebGLRenderer(canvas: HTMLCanvasElement, labelCanvas: HTMLCanvasElement, scene: PreparedMemoryGraphScene): MemoryGraphWebGLRenderer {
+  const gl = canvas.getContext("webgl2", { alpha: false, antialias: true, depth: true, powerPreference: "high-performance" });
+  if (!gl) throw new Error("WebGL2 is unavailable");
