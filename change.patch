+import type { MemoryCamera3D } from "./memory-3d.js";
+import type { PreparedMemoryGraphScene } from "./memory-graph-scene.js";
+import { MemoryGraphSpatialIndex, MEMORY_NODE_CORE, type MemoryGraphViewport } from "./memory-graph-picking.js";
+import { memoryGraphLabelFits, selectMemoryGraphLabelIndices, type MemoryGraphLabelBox } from "./memory-graph-labels.js";
+
+export interface MemoryGraphRenderOptions { showTitles: boolean; selectedIndex: number; hoverIndex: number }
+export interface MemoryGraphRenderStats {
+  renderWallMs: number;
+  indexUpdateMs: number;
+  labelMeasured: number;
+  labelDrawn: number;
+}
+export interface MemoryGraphPickResult { index: number | null; queryMs: number; indexUpdateMs: number; totalMs: number }
+export interface MemoryGraphWebGLRenderer {
+  setCoordinates(xyz: Float32Array, extent: number): void;
+  resize(cssWidth: number, cssHeight: number, dpr: number): void;
+  render(camera: MemoryCamera3D, options: MemoryGraphRenderOptions): MemoryGraphRenderStats;
+  pick(x: number, y: number, camera: MemoryCamera3D, options: Pick<MemoryGraphRenderOptions, "selectedIndex" | "hoverIndex">): MemoryGraphPickResult;
+  dispose(): void;
+}
+
+const projection = `
+uniform vec2 uViewport;
+uniform float uDpr;
+uniform float uScale;
+uniform float uExtent;
+uniform vec3 uCamera;
+vec3 project(vec3 p) {
+ float cy=cos(uCamera.x),sy=sin(uCamera.x),cp=cos(uCamera.y),sp=sin(uCamera.y);
+ float x=p.x*cy+p.z*sy,d=-p.x*sy+p.z*cy;
+ return vec3(x,p.y*cp-d*sp,p.y*sp+d*cp);
+}
+vec4 clip(vec3 p,vec2 offset) {
+ float perspective=650.0/max(120.0,650.0+p.z*uScale);
+ return vec4((p.xy*uScale*uCamera.z*perspective+offset)*uDpr*2.0/uViewport,p.z/max(1.0,uExtent*4.0),1.0);
+}`;
+const nodeVertex = `#version 300 es
+precision highp float;
+layout(location=0) in vec2 aCorner;
+layout(location=1) in vec3 aPosition;
+layout(location=2) in vec3 aColor;
+layout(location=3) in float aRadius;
+layout(location=4) in float aState;
+${projection}
+uniform bool uHasFocus;
+uniform bool uGlowPass;
+out vec2 vCorner;
+out vec3 vColor;
+out float vAlpha;
+void main(){
+ vec3 p=project(aPosition);
+ float perspective=650.0/max(120.0,650.0+p.z*uScale);
+ bool focused=aState>1.5;
+ float radius=max(1.0,aRadius*perspective*sqrt(uCamera.z))*(focused?1.5:1.0);
