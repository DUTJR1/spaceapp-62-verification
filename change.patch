+    gl.bindVertexArray(glowVao); attribute(0, cornerBuffer, 2, gl.FLOAT, 0, 0, 0); attribute(1, glowBuffer, 3, gl.FLOAT, 32, 0); attribute(2, glowBuffer, 3, gl.FLOAT, 32, 12); attribute(3, glowBuffer, 1, gl.FLOAT, 32, 24); attribute(4, glowBuffer, 1, gl.FLOAT, 32, 28);
+    let normalEdges = 0;
+    for (const flag of scene.edgeFlags) if (!(flag & 1)) normalEdges++;
+    const orderedEdges = new Uint32Array(scene.edgeIndices.length);
+    let normalOffset = 0, derivedOffset = normalEdges * 2;
+    for (let i = 0; i < edgeCount; i++) {
