+ vAlpha=uHasFocus&&aState<0.5?0.2:clamp(perspective,0.4,1.0);
+}`;
+const nodeFragment = `#version 300 es
+precision highp float;
+in vec2 vCorner;
+in vec3 vColor;
+in float vAlpha;
+uniform bool uGlowPass;
+out vec4 outColor;
+void main(){
+ float radius=length(vCorner);
+ if(uGlowPass){
+  if(radius<=1.0||radius>1.8)discard;
+  float glow=(1.8-radius)/0.8;
+  outColor=vec4(vColor,glow*glow*0.28*vAlpha);
