+import { describe, expect, it } from "vitest";
+import { listMemoryGraphOverviewQuerySchema, memoryGraphOverviewPayloadSchema, memoryGraphPayloadSchema } from "../src/index.js";
+
+const node = (id: number) => ({ id: `memory:${id}`, type: "MEMORY", label: `Memory ${id}`, sourcePath: null, recordId: null });
+const payload = {
+  version: 1, generatedAt: "2026-07-18T12:00:00.000Z", sourceHash: "a".repeat(64), isStale: false,
+  summary: { sourceCount: 0, recordCount: 0, nodeCount: 2500, edgeCount: 0, issueCount: 0 },
+  nodes: Array.from({ length: 2500 }, (_, id) => node(id)), edges: [],
+  filters: { q: null, nodeType: null, scope: null, roomId: null, sourcePath: null, lifecycleStatus: null, relationMode: "RELATIONS" },
+  months: [], totalMatchingNodes: 2500, totalMatchingEdges: 0, truncated: false
+};
+
+describe("memory graph overview limits", () => {
+  it("keeps the 2000 default and accepts bounded integer limits through query strings", () => {
+    expect(listMemoryGraphOverviewQuerySchema.parse({}).limit).toBe(2000);
+    expect(listMemoryGraphOverviewQuerySchema.parse({ limit: "50000" }).limit).toBe(50000);
+    expect(listMemoryGraphOverviewQuerySchema.parse({ limit: 1 }).limit).toBe(1);
+    for (const limit of [0, -1, 1.5, "oops", 50001]) expect(listMemoryGraphOverviewQuerySchema.safeParse({ limit }).success).toBe(false);
+  });
+
+  it("allows a large overview while keeping paginated graph budgets separate", () => {
+    expect(memoryGraphOverviewPayloadSchema.parse(payload).nodes).toHaveLength(2500);
+    expect(memoryGraphPayloadSchema.safeParse(payload).success).toBe(false);
+  });
+});
