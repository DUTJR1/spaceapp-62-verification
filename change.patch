+import { describe, expect, it } from "vitest";
+import { MEMORY_GRAPH_LABEL_BUDGET, memoryGraphLabelFits, selectMemoryGraphLabelIndices } from "../src/features/memory-workspace/memory-graph-labels.js";
+
+describe("memory graph label LOD", () => {
+  it("prioritizes focus and core, keeps source-only labels at low zoom", () => {
+    const flags = new Uint8Array([3, 1, 1, 0, 0]);
+    expect(selectMemoryGraphLabelIndices(flags, new Uint32Array([0, 1, 2]), 1, 4)).toEqual([4, 0, 1, 2]);
+    expect(selectMemoryGraphLabelIndices(flags, new Uint32Array([0, 1, 2]), 1)).toEqual([0, 1, 2]);
+    const close = selectMemoryGraphLabelIndices(flags, new Uint32Array([0, 1, 2]), 2);
+    expect(close).toContain(3); expect(close).toContain(4);
+    expect(new Set(close).size).toBe(close.length);
+  });
+
+  it("bounds label work at 50k and samples source labels throughout the graph", () => {
+    const flags = new Uint8Array(50_000).fill(1), sources = Uint32Array.from({ length: 50_000 }, (_, i) => i);
+    flags[0] = 3;
+    for (const zoom of [0.35, 1, 2, 5]) {
+      const labels = selectMemoryGraphLabelIndices(flags, sources, zoom, 49_999);
+      expect(labels[0]).toBe(49_999); expect(labels[1]).toBe(0);
+      expect(labels.length).toBeLessThanOrEqual(MEMORY_GRAPH_LABEL_BUDGET);
+      expect(labels.some(index => index > 40_000 && index < 49_999)).toBe(true);
+    }
+    expect(selectMemoryGraphLabelIndices(flags, sources, 2, -1, 0)).toEqual([]);
+    expect(selectMemoryGraphLabelIndices(flags, sources, 2, -1, 5).length).toBeLessThanOrEqual(5);
+  });
+
+  it("rejects colliding and clipped labels while allowing separate rows", () => {
+    const existing = [{ x: 20, y: 30, width: 80 }];
+    expect(memoryGraphLabelFits({ x: 90, y: 34, width: 40 }, existing, 300, 200)).toBe(false);
+    expect(memoryGraphLabelFits({ x: 90, y: 50, width: 40 }, existing, 300, 200)).toBe(true);
+    expect(memoryGraphLabelFits({ x: 280, y: 50, width: 40 }, [], 300, 200)).toBe(false);
+    expect(memoryGraphLabelFits({ x: -1, y: 50, width: 40 }, [], 300, 200)).toBe(false);
+    expect(memoryGraphLabelFits({ x: 20, y: 5, width: 40 }, [], 300, 200)).toBe(false);
+  });
+});
