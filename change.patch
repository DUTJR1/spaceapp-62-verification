@@ -0,0 +1,84 @@
+import { describe, expect, it } from "vitest";
+import { projectMemoryPoint, type MemoryCamera3D } from "../src/features/memory-workspace/memory-3d.js";
+import { MemoryGraphSpatialIndex, type MemoryGraphViewport } from "../src/features/memory-workspace/memory-graph-picking.js";
+
+const viewport: MemoryGraphViewport = { width: 1280, height: 640, dpr: 1, pixelWidth: 1280, pixelHeight: 640 };
+const camera = { yaw: 0, pitch: 0, zoom: 1 };
+
+function exhaustive(xyz: Float32Array, flags: Uint8Array, extent: number, view: MemoryCamera3D, x: number, y: number, focus = -1) {
+  const qx = Math.floor(x) + 0.5, qy = Math.floor(y) + 0.5;
+  let best: number | null = null, closestDepth = Infinity;
+  for (let i = 0; i < flags.length; i++) {
+    const p = projectMemoryPoint({ x: xyz[i * 3]!, y: xyz[i * 3 + 1]!, z: xyz[i * 3 + 2]! }, view, 640 * 0.4 / extent, 1280, 640);
+    const radius = Math.max(1, (flags[i]! & 2 ? 10 : flags[i]! & 1 ? 4.6 : 2.1) * p.perspective * Math.sqrt(view.zoom)) * (i === focus ? 1.5 : 1);
+    if ((p.x - qx) ** 2 + (p.y - qy) ** 2 > radius ** 2 || p.z < -extent * 4 || p.z > extent * 4) continue;
+    const depth = Math.round((p.z / (extent * 4) * 0.5 + 0.5) * (2 ** 24 - 1));
+    if (depth <= closestDepth) { best = i; closestDepth = depth; }
+  }
+  return best;
+}
+
+describe("memory graph spatial picking", () => {
+  it("picks the nearest circle and later instances on equal GPU depth", () => {
+    const index = new MemoryGraphSpatialIndex(new Uint8Array([0, 0]));
+    index.update(new Float32Array([0, 0, -10, 0, 0, 10]), 1, 60, camera, viewport);
+    expect(index.query(640, 320)).toBe(0);
+    index.update(new Float32Array([0, 0, 0, 0, 0, 0]), 2, 60, camera, viewport);
+    expect(index.query(640, 320)).toBe(1);
+  });
+
+  it("tests circles instead of square billboards and respects highlighted radius", () => {
+    const index = new MemoryGraphSpatialIndex(new Uint8Array([0]));
+    index.update(new Float32Array([0, 0, 0]), 1, 60, camera, viewport);
+    expect(index.query(642, 322)).toBeNull();
+    expect(index.query(642, 320)).toBeNull();
+    expect(index.query(642, 320, 0)).toBe(0);
+  });
+
+  it("invalidates camera, zoom, CSS size, backing size, DPR and coordinate revisions", () => {
+    const index = new MemoryGraphSpatialIndex(new Uint8Array([1]));
+    const xyz = new Float32Array([10, 20, 30]);
+    expect(index.update(xyz, 1, 60, camera, viewport)).toBe(true);
+    expect(index.update(xyz, 1, 60, { ...camera }, { ...viewport })).toBe(false);
+    expect(index.update(xyz, 1, 60, { ...camera, yaw: 0.3 }, viewport)).toBe(true);
+    expect(index.update(xyz, 1, 60, { ...camera, zoom: 2 }, viewport)).toBe(true);
+    expect(index.update(xyz, 1, 60, camera, { ...viewport, width: 1281, pixelWidth: 1281 })).toBe(true);
+    expect(index.update(xyz, 1, 60, camera, { ...viewport, dpr: 2, pixelWidth: 2560, pixelHeight: 1280 })).toBe(true);
+    xyz[0] = 50;
+    expect(index.update(xyz, 2, 60, camera, viewport)).toBe(true);
+    expect(index.update(xyz, 2, 60, camera, viewport)).toBe(false);
+    expect(index.update(xyz.slice(), 2, 60, camera, viewport)).toBe(true);
+  });
+
+  it("agrees with an independent exhaustive projection at 50k across camera states", () => {
+    const count = 50_000, xyz = new Float32Array(count * 3), flags = new Uint8Array(count);
+    let seed = 622026;
+    const random = () => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed / 2 ** 32; };
+    for (let i = 0; i < count; i++) {
+      xyz[i * 3] = (random() - 0.5) * 240; xyz[i * 3 + 1] = (random() - 0.5) * 240; xyz[i * 3 + 2] = (random() - 0.5) * 240;
+      flags[i] = i === 0 ? 3 : i % 100 === 0 ? 1 : 0;
+    }
+    const index = new MemoryGraphSpatialIndex(flags);
+    for (const view of [{ yaw: 0.3, pitch: -0.15, zoom: 1 }, { yaw: 1.7, pitch: 0.4, zoom: 1.3 }, { yaw: -2.1, pitch: 1.2, zoom: 0.5 }]) {
+      index.update(xyz, 1, 220, view, viewport);
+      for (let i = 0; i < 12; i++) {
+        const x = 440 + i * 36, y = 180 + (i * 47) % 280;
+        expect(index.query(x, y)).toBe(exhaustive(xyz, flags, 220, view, x, y));
+      }
+    }
+  });
+
+  it("handles empty scenes, fractional sizes and offscreen centers without scanning all nodes", () => {
+    const empty = new MemoryGraphSpatialIndex(new Uint8Array());
+    empty.update(new Float32Array(), 1, 60, camera, viewport);
+    expect(empty.query(10, 10)).toBeNull();
+    const index = new MemoryGraphSpatialIndex(new Uint8Array([3]));
+    const view = { width: 100.3, height: 100.7, dpr: 2, pixelWidth: 201, pixelHeight: 201 };
+    index.update(new Float32Array([-73.5, 0, 0]), 1, 60, camera, view);
+    expect(index.query(0, 50)).toBe(0);
+    expect(index.lastCandidateCount).toBe(1);
+    expect(index.query(Number.NaN, 0)).toBeNull();
+    expect(() => index.update(new Float32Array(2), 2, 60, camera, viewport)).toThrow(/Coordinate count/);
+    expect(() => index.update(new Float32Array(3), 2, 60, { ...camera, zoom: 0 }, viewport)).toThrow(/Invalid/);
+  });
+});
