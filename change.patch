+import assert from "node:assert/strict";
+import { performance } from "node:perf_hooks";
+import { writeFile, mkdir } from "node:fs/promises";
+import { dirname } from "node:path";
+import { describe, expect, it } from "vitest";
+import type { MemoryGraphSnapshot } from "@space/contracts";
+import { InMemorySpaceStore } from "@space/runtime";
+import { createApp } from "../src/app.js";
+import { getApiConfig } from "../src/config.js";
+import { signSession } from "../src/auth.js";
+import { createSyntheticMemoryGraph, SYNTHETIC_MEMORY_GRAPH_SEED } from "../../web/src/demo/synthetic-memory-graph.js";
+import { memoryGraphStreamingFixture } from "./support/memory-graph-streaming-fixture.js";
+
+// Deliberately opt-in: this measures a large rich fixture and should not compete
+// with an integrated-GPU frame benchmark. It never starts a network listener.
+describe.runIf(process.env.SPACE_MEMORY_BENCHMARK === "1")("rich overview response benchmark", () => {
+  it("measures the real route while preserving every rich node and edge field", async () => {
+    const fixture = createSyntheticMemoryGraph(50000);
+    // This is a synthetic graph-service projection. It does not benchmark memory
+    // ingestion, stored-snapshot validation, indexing, a DB, or provider calls.
+    const snapshot: MemoryGraphSnapshot = { ...fixture, records: [], issues: [] };
+    const secret = "synthetic-benchmark-secret-at-least-32-characters";
+    const token = signSession({ id: "user:operator", email: "benchmark@space.test", role: "OPERATOR" }, secret);
+    const store = new InMemorySpaceStore();
+    const app = await createApp({
+      store,
+      ...memoryGraphStreamingFixture(store),
+      config: getApiConfig({ SPACE_MEMORY_GRAPH_ENABLED: "true", SPACE_MEMORY_MAINTENANCE_ENABLED: "false", SPACE_MEMORY_MUTATIONS_ENABLED: "false", SPACE_BROWSER_EVIDENCE_ENABLED: "false" }),
+      auth: { sessionSecret: secret, devLogin: false, secureCookies: false },
+      canonicalMemory: { async list() { return []; }, async save() { throw new Error("The benchmark never writes memory."); } },
+      memoryGraphService: {
+        async getSnapshot() { return { snapshot, isStale: false }; },
+        async getCachedSnapshot() { return snapshot; },
+        async invalidateCachedSnapshot() {},
+        async getArchiveSnapshot() { return snapshot; },
+        async listAvailableMonths() { return fixture.months; },
+        async getSourceContent() { throw new Error("The benchmark never reads source files."); }
+      }
+    });
+    try {
+      await app.ready();
+      const start = performance.now();
+      const response = await app.inject({ method: "GET", url: "/api/admin/memory/graph/overview?limit=50000&month=all", headers: { cookie: `space_session=${token}` } });
+      const routeMs = performance.now() - start;
+      expect(response.statusCode).toBe(200);
+      const data = response.json().data;
+      expect(data.nodes).toHaveLength(50000);
+      expect(data.edges).toHaveLength(150000);
+      expect(data.truncated).toBe(false);
+      const nodes = new Map(fixture.nodes.map(node => [node.id, node]));
+      const edges = new Map(fixture.edges.map(edge => [edge.id, edge]));
+      for (const node of data.nodes) assert.deepEqual(node, nodes.get(node.id));
+      for (const edge of data.edges) assert.deepEqual(edge, edges.get(edge.id));
+      const report = {
+        mode: "SYNTHETIC_GRAPH_SERVICE_PROJECTION", seed: SYNTHETIC_MEMORY_GRAPH_SEED,
+        nodeVersion: process.version, platform: process.platform, arch: process.arch,
+        nodes: data.nodes.length, edges: data.edges.length,
+        responseDecodedBytes: Buffer.byteLength(response.body, "utf8"),
+        routeAndSerializationMs: routeMs,
+        richNodeFieldsPreserved: true, richEdgeFieldsPreserved: true,
+        includes: ["session authentication", "route selection", "redaction", "response schema validation", "JSON serialization"],
+        excludes: ["TCP transfer", "storage ingestion", "stored-snapshot validation", "database/index/provider throughput", "browser parse/render/frame time"]
+      };
+      console.info(JSON.stringify(report));
+      const reportPath = process.env.SPACE_MEMORY_BENCHMARK_REPORT;
+      if (reportPath) { await mkdir(dirname(reportPath), { recursive: true }); await writeFile(reportPath, JSON.stringify(report, null, 2) + "\n", "utf8"); }
+    } finally { await app.close(); }
+  }, 120_000);
+});
