+import { describe, expect, it, vi } from "vitest";
+import type { MemoryGraphOverviewPayload } from "@space/contracts";
+import { createMemoryAtlas } from "../src/features/memory-workspace/memory-atlas.js";
+import { createMemoryGraphDataController, prepareMemoryGraphScene, syntheticMemoryOverview } from "../src/features/memory-workspace/memory-graph-data-core.js";
+import { memoryGraphOverviewUrl } from "../src/features/memory-workspace/memory-graph-data-source.js";
+import type { MemoryGraphDataResponse } from "../src/features/memory-workspace/memory-graph-scene.js";
+import { createSyntheticMemoryGraph } from "../src/demo/synthetic-memory-graph.js";
+
+function fixture(): MemoryGraphOverviewPayload {
+  return {
+    version: 1, generatedAt: "2026-07-18T12:00:00.000Z", sourceHash: "a".repeat(64), isStale: false,
+    summary: { sourceCount: 1, recordCount: 2, nodeCount: 3, edgeCount: 2, issueCount: 0 },
+    nodes: [
+      { id: "memory:b", type: "MEMORY", label: "Second", sourcePath: "/demo/space.md", recordId: "memory:b", clusterId: "cluster:b", position: { clustered: { x: 2, y: 3 }, relations: { x: 4, y: 5 } } },
+      { id: "source:root", type: "SOURCE", label: "space.md", sourcePath: "/demo/space.md", recordId: null },
+      { id: "memory:a", type: "MEMORY", label: "First", sourcePath: "/demo/space.md", recordId: "memory:a", cacheRecordId: "cache:one" }
+    ],
+    edges: [
+      { id: "edge:one", type: "CONTAINS", source: "source:root", target: "memory:b", evidence: "合成业务备注：retained evidence", confidence: 1 },
+      { id: "edge:two", type: "DERIVED_FROM", source: "source:root", target: "memory:a", evidence: "Every domain field survives the worker path." }
+    ],
+    filters: { q: null, nodeType: null, scope: null, roomId: null, sourcePath: null, lifecycleStatus: null, relationMode: "RELATIONS", month: null },
+    months: [], totalMatchingNodes: 3, totalMatchingEdges: 2, truncated: false
+  };
+}
+
+describe("memory graph data worker core", () => {
+  it("builds the overview URL without dropping the limit or escaping search incorrectly", () => {
+    const url = new URL(memoryGraphOverviewUrl({ limit: 50000, q: "alpha & beta", month: "all" }), "http://local.test");
+    expect(url.searchParams.get("limit")).toBe("50000");
+    expect(url.searchParams.get("q")).toBe("alpha & beta");
+    expect(url.searchParams.get("month")).toBe("all");
+  });
+
+  it("waits for ACK, preserves rich domain data, and prepares CSR in atlas input order", async () => {
+    const data = fixture();
+    const messages: MemoryGraphDataResponse[] = [];
+    const controller = createMemoryGraphDataController(message => messages.push(message));
+    const loading = controller.handle({ type: "load", jobId: 7, source: { kind: "inline", data } });
+    expect(messages.map(message => message.type)).toEqual(["meta", "nodes"]);
+    await controller.handle({ type: "ack", jobId: 999, sequence: 0 });
+    expect(messages.map(message => message.type)).toEqual(["meta", "nodes"]);
+    await controller.handle({ type: "ack", jobId: 7, sequence: 0 });
+    await vi.waitFor(() => expect(messages.some(message => message.type === "edges")).toBe(true));
+    const edgeBatch = messages.find(message => message.type === "edges");
+    expect(edgeBatch?.type).toBe("edges");
+    if (edgeBatch?.type === "edges") {
+      expect(edgeBatch.edges).toEqual(data.edges);
+      await controller.handle({ type: "ack", jobId: 7, sequence: edgeBatch.sequence });
+    }
+    await loading;
+    const nodeBatch = messages.find(message => message.type === "nodes");
+    expect(nodeBatch?.type === "nodes" && nodeBatch.nodes).toEqual(data.nodes);
+    const prepared = messages.find(message => message.type === "prepared");
+    expect(prepared?.type).toBe("prepared");
+    if (prepared?.type === "prepared") {
+      expect(prepared.scene.nodeIds).toEqual(data.nodes.map(node => node.id));
+      expect([...prepared.scene.sourceIndices]).toEqual([1]);
+      expect([...prepared.scene.edgeIndices]).toEqual([1, 0, 1, 2]);
+      expect([...prepared.scene.adjacencyOffsets]).toEqual([0, 1, 3, 4]);
+      expect([...prepared.scene.adjacencyNodes]).toEqual([1, 0, 2, 1]);
+      expect(prepared.decodedBytes).toBe(new TextEncoder().encode(JSON.stringify({ data })).byteLength);
+    }
+    expect(messages[messages.length - 1]?.type).toBe("complete");
+    await controller.handle({ type: "detail", jobId: 7, nodeId: "memory:b", detailRequestId: 501 });
+    const detail = messages[messages.length - 1];
+    expect(detail?.type === "detail" && detail.detail.node).toEqual(data.nodes[0]);
+    expect(detail).toMatchObject({ type: "detail", detailRequestId: 501 });
+    await controller.handle({ type: "detail", jobId: 7, nodeId: "missing:node", detailRequestId: 502 });
+    expect(messages[messages.length - 1]).toMatchObject({ type: "error", detailRequestId: 502, code: "NOT_FOUND" });
+    controller.cancel();
+  });
+
+  it("streams small fixed-seed graphs in bounded batches and passes only lightweight layout input", async () => {
+    const messages: MemoryGraphDataResponse[] = [];
+    const port = { postMessage: vi.fn(), close: vi.fn() };
+    const controller = createMemoryGraphDataController(message => {
+      messages.push(message);
+      if (message.type === "nodes" || message.type === "edges") queueMicrotask(() => void controller.handle({ type: "ack", jobId: message.jobId, sequence: message.sequence }));
+    });
+    await controller.handle({ type: "load", jobId: 8, source: { kind: "synthetic", size: 2000, seed: 622026 }, layoutPort: port as unknown as MessagePort });
+    const nodes = messages.flatMap(message => message.type === "nodes" ? message.nodes : []);
+    const edges = messages.flatMap(message => message.type === "edges" ? message.edges : []);
+    expect(nodes).toHaveLength(2000);
+    expect(edges).toHaveLength(6000);
+    for (const message of messages) {
+      if (message.type === "nodes") expect(message.nodes.length).toBeLessThanOrEqual(512);
+      if (message.type === "edges") expect(message.edges.length).toBeLessThanOrEqual(2048);
+    }
+    const layout = port.postMessage.mock.calls[0]![0];
+    expect(layout.nodes.map((node: { id: string }) => node.id)).toEqual(nodes.map(node => node.id));
+    expect(layout.edges[0]).not.toHaveProperty("evidence");
+    expect(edges.find(edge => edge.evidence)?.evidence).toContain("Synthetic");
+    expect(messages[messages.length - 1]?.type).toBe("complete");
+    controller.cancel();
+  });
+
+  it("fetches with same-origin credentials, parses real response fields and reports errors", async () => {
+    const fetcher = vi.fn(async () => new Response(JSON.stringify({ data: fixture() }), { status: 200, headers: { "content-type": "application/json" } }));
+    const messages: MemoryGraphDataResponse[] = [];
+    const controller = createMemoryGraphDataController(message => {
+      messages.push(message);
+      if (message.type === "nodes" || message.type === "edges") queueMicrotask(() => void controller.handle({ type: "ack", jobId: message.jobId, sequence: message.sequence }));
+    }, { fetch: fetcher as typeof fetch, origin: "http://local.test" });
+    await controller.handle({ type: "load", jobId: 9, source: { kind: "api", url: "/api/admin/memory/graph/overview?limit=50000" } });
+    expect(fetcher).toHaveBeenCalledWith("http://local.test/api/admin/memory/graph/overview?limit=50000", expect.objectContaining({ credentials: "same-origin", cache: "no-store" }));
+    expect(messages[messages.length - 1]?.type).toBe("complete");
+    await controller.handle({ type: "load", jobId: 10, source: { kind: "api", url: "https://other.test/api/admin/memory/graph/overview" } });
+    expect(messages[messages.length - 1]).toMatchObject({ type: "error", code: "INVALID_MEMORY_SOURCE" });
+    controller.cancel();
+  });
+
+  it("rejects unknown edge endpoints and cancels a load waiting for ACK", async () => {
+    const data = fixture(); data.edges[0]!.target = "missing:node";
+    const messages: MemoryGraphDataResponse[] = [];
+    const controller = createMemoryGraphDataController(message => messages.push(message));
+    await controller.handle({ type: "load", jobId: 1, source: { kind: "inline", data } });
+    expect(messages[messages.length - 1]).toMatchObject({ type: "error", code: "INVALID_MEMORY_GRAPH" });
+    const waiting = controller.handle({ type: "load", jobId: 2, source: { kind: "inline", data: fixture() } });
+    controller.cancel();
+    await waiting;
+    expect(messages.some(message => message.jobId === 2 && message.type === "complete")).toBe(false);
+  });
+
+  it("retains the default fallback sample budget without mutating the rich fixture", () => {
+    const graph = createSyntheticMemoryGraph(2000);
+    const full = syntheticMemoryOverview(graph);
+    const sampled = syntheticMemoryOverview(graph, { limit: 1 });
+    expect(full.nodes).toHaveLength(2000);
+    expect(sampled.nodes).toHaveLength(1);
+    expect(sampled.nodes[0]?.label).toBe("space.md");
+    expect(sampled.truncated).toBe(true);
+    expect(graph.nodes).toHaveLength(2000);
+    const scene = prepareMemoryGraphScene(createMemoryAtlas(fixture().nodes, fixture().edges, false));
+    expect(scene.colors.length).toBe(9);
+  });
+
+  it("a new load cancels an old load and an old ACK cannot release the new batch", async () => {
+    const messages: MemoryGraphDataResponse[] = [];
+    const controller = createMemoryGraphDataController(message => messages.push(message));
+    const first = controller.handle({ type: "load", jobId: 20, source: { kind: "inline", data: fixture() } });
+    const second = controller.handle({ type: "load", jobId: 21, source: { kind: "inline", data: fixture() } });
+    await first;
+    await controller.handle({ type: "ack", jobId: 20, sequence: 0 });
+    expect(messages.filter(message => message.jobId === 21).map(message => message.type)).toEqual(["meta", "nodes"]);
+    await controller.handle({ type: "ack", jobId: 21, sequence: 0 });
+    await vi.waitFor(() => expect(messages.some(message => message.jobId === 21 && message.type === "edges")).toBe(true));
+    const edges = messages.find(message => message.jobId === 21 && message.type === "edges");
+    if (edges?.type !== "edges") throw new Error("Expected the new job's edge batch.");
+    await controller.handle({ type: "ack", jobId: 21, sequence: edges.sequence });
+    await second;
+    expect(messages.some(message => message.jobId === 20 && message.type === "complete")).toBe(false);
+    expect(messages[messages.length - 1]).toMatchObject({ type: "complete", jobId: 21 });
+    controller.cancel();
+  });
+});
