@@ -0,0 +1,295 @@
+import {
+  listMemoryGraphOverviewQuerySchema,
+  memoryGraphNodeDetailSchema,
+  memoryGraphOverviewPayloadSchema,
+  type MemoryGraphEdge,
+  type MemoryGraphNode,
+  type MemoryGraphNodeDetail,
+  type MemoryGraphOverviewPayload,
+  type MemoryGraphPayload
+} from "@space/contracts";
+import { createSyntheticMemoryGraph } from "../../demo/synthetic-memory-graph.js";
+import { createMemoryAtlas } from "./memory-atlas.js";
+import { isMemoryCoreLabel } from "./memory-graph-visuals.js";
+import type { MemoryGraphOverviewQuery } from "./memory-graph-data-source.js";
+import type {
+  Memory3DLayoutRequest,
+  MemoryGraphDataRequest,
+  MemoryGraphDataResponse,
+  MemoryGraphSource,
+  MemoryGraphTimings,
+  PreparedMemoryGraphScene
+} from "./memory-graph-scene.js";
+
+const NODE_BATCH_SIZE = 512;
+const EDGE_BATCH_SIZE = 2048;
+const encoder = new TextEncoder();
+
+class GraphDataError extends Error {
+  constructor(message: string, readonly status?: number, readonly code?: string, readonly requestId?: string) { super(message); }
+}
+
+/** Applies real graph relationships and a bounded sample, without inventing links. */
+export function syntheticMemoryOverview(graph: MemoryGraphPayload, input: MemoryGraphOverviewQuery = {}): MemoryGraphOverviewPayload {
+  const query = listMemoryGraphOverviewQuerySchema.parse({ ...input, limit: input.limit ?? graph.nodes.length });
+  const needle = query.q?.toLowerCase();
+  const anchors = graph.nodes.filter(node =>
+    (!needle || node.label.toLowerCase().includes(needle) || node.sourcePath?.toLowerCase().includes(needle)) &&
+    (!query.nodeType || node.type === query.nodeType) &&
+    (!query.sourcePath || node.sourcePath === query.sourcePath) &&
+    (!query.month || query.month === "all" || node.sourcePath?.endsWith(`/space_memory_${query.month}.md`)) &&
+    // The fixture contains structural memory nodes, not record-body/scope fixtures.
+    !query.scope && !query.roomId && !query.lifecycleStatus
+  );
+  const anchorIds = new Set(anchors.map(node => node.id));
+  const relatedIds = new Set<string>();
+  if (query.relationMode === "RELATIONS") for (const edge of graph.edges) {
+    if (anchorIds.has(edge.source)) relatedIds.add(edge.target);
+    if (anchorIds.has(edge.target)) relatedIds.add(edge.source);
+  }
+  const matching = [...anchors, ...graph.nodes.filter(node => !anchorIds.has(node.id) && relatedIds.has(node.id))];
+  const matchingIds = new Set(matching.map(node => node.id));
+  const matchingEdges = graph.edges.filter(edge => matchingIds.has(edge.source) && matchingIds.has(edge.target) &&
+    (query.relationMode !== "RELATIONS" || anchorIds.has(edge.source) || anchorIds.has(edge.target)));
+  let nodes = matching;
+  if (nodes.length > query.limit) {
+    const sources = matching.filter(node => node.type === "SOURCE").sort((a, b) => Number(isMemoryCoreLabel(b.label)) - Number(isMemoryCoreLabel(a.label)) || a.id.localeCompare(b.id)).slice(0, Math.min(query.limit, 120));
+    const selected = new Map(sources.map(node => [node.id, node]));
+    for (const node of matching) { if (selected.size >= query.limit) break; selected.set(node.id, node); }
+    nodes = [...selected.values()];
+  }
+  const selectedIds = new Set(nodes.map(node => node.id));
+  const edgeLimit = query.limit === 2000 ? 6000 : Math.min(200000, Math.max(6000, query.limit * 4));
+  const edges = matchingEdges.filter(edge => selectedIds.has(edge.source) && selectedIds.has(edge.target)).slice(0, edgeLimit);
+  return {
+    ...graph,
+    nodes,
+    edges,
+    totalMatchingNodes: matching.length,
+    totalMatchingEdges: matchingEdges.length,
+    truncated: nodes.length !== matching.length || edges.length !== matchingEdges.length,
+    filters: { q: query.q ?? null, nodeType: query.nodeType ?? null, scope: query.scope ?? null, roomId: query.roomId ?? null, sourcePath: query.sourcePath ?? null, lifecycleStatus: query.lifecycleStatus ?? null, relationMode: query.relationMode, month: query.month ?? null }
+  };
+}
+
+export function assertMemoryGraphReferences(graph: MemoryGraphOverviewPayload): void {
+  const ids = new Set<string>();
+  for (const node of graph.nodes) {
+    if (ids.has(node.id)) throw new GraphDataError(`Duplicate memory node: ${node.id}`, undefined, "INVALID_MEMORY_GRAPH");
+    ids.add(node.id);
+  }
+  for (const edge of graph.edges) if (!ids.has(edge.source) || !ids.has(edge.target)) {
+    throw new GraphDataError(`Memory edge has an unknown endpoint: ${edge.id}`, undefined, "INVALID_MEMORY_GRAPH");
+  }
+}
+
+/** The compact rendering representation accompanies, and never replaces, rich data. */
+export function prepareMemoryGraphScene(atlas: ReturnType<typeof createMemoryAtlas>): PreparedMemoryGraphScene {
+  const count = atlas.nodes.length;
+  const nodeIds = atlas.nodes.map(node => node.id);
+  const labels = atlas.nodes.map(node => node.label);
+  const index = new Map(nodeIds.map((id, offset) => [id, offset]));
+  const flags = new Uint8Array(count);
+  const colors = new Float32Array(count * 3);
+  const sourceIndices: number[] = [];
+  const coreIndices: number[] = [];
+  const colorCache = new Map<string, [number, number, number]>();
+  for (let offset = 0; offset < count; offset++) {
+    const node = atlas.nodes[offset]!;
+    const core = node.type === "SOURCE" && isMemoryCoreLabel(node.label);
+    flags[offset] = (node.type === "SOURCE" ? 1 : 0) | (core ? 2 : 0);
+    if (node.type === "SOURCE") (core ? coreIndices : sourceIndices).push(offset);
+    const color = atlas.positions.get(node.id)?.color ?? "#7395ad";
+    let rgb = colorCache.get(color);
+    if (!rgb) {
+      const hex = Number.parseInt(color.slice(1), 16);
+      rgb = [(hex >>> 16 & 255) / 255, (hex >>> 8 & 255) / 255, (hex & 255) / 255];
+      colorCache.set(color, rgb);
+    }
+    colors.set(rgb, offset * 3);
+  }
+  const edgeIndices = new Uint32Array(atlas.edges.length * 2);
+  const edgeFlags = new Uint8Array(atlas.edges.length);
+  const adjacencyOffsets = new Uint32Array(count + 1);
+  for (let offset = 0; offset < atlas.edges.length; offset++) {
+    const edge = atlas.edges[offset]!;
+    const source = index.get(edge.source), target = index.get(edge.target);
+    if (source === undefined || target === undefined) throw new GraphDataError("Atlas edge references a hidden node.", undefined, "INVALID_MEMORY_GRAPH");
+    edgeIndices[offset * 2] = source;
+    edgeIndices[offset * 2 + 1] = target;
+    edgeFlags[offset] = edge.type === "DERIVED_FROM" ? 1 : 0;
+    adjacencyOffsets[source + 1]!++;
+    adjacencyOffsets[target + 1]!++;
+  }
+  for (let offset = 1; offset <= count; offset++) adjacencyOffsets[offset]! += adjacencyOffsets[offset - 1]!;
+  const adjacencyNodes = new Uint32Array(atlas.edges.length * 2);
+  const cursors = adjacencyOffsets.slice(0, count);
+  for (let offset = 0; offset < edgeIndices.length; offset += 2) {
+    const source = edgeIndices[offset]!, target = edgeIndices[offset + 1]!;
+    adjacencyNodes[cursors[source]!] = target; cursors[source]!++;
+    adjacencyNodes[cursors[target]!] = source; cursors[target]!++;
+  }
+  return { nodeIds, labels, flags, colors, edgeIndices, edgeFlags, sourceIndices: Uint32Array.from([...coreIndices, ...sourceIndices]), adjacencyOffsets, adjacencyNodes };
+}
+
+export function memoryGraphSceneTransfers(scene: PreparedMemoryGraphScene): Transferable[] {
+  return [scene.flags.buffer, scene.colors.buffer, scene.edgeIndices.buffer, scene.edgeFlags.buffer, scene.sourceIndices.buffer, scene.adjacencyOffsets.buffer, scene.adjacencyNodes.buffer] as ArrayBuffer[];
+}
+
+type PostResponse = (message: MemoryGraphDataResponse, transfers?: Transferable[]) => void;
+type ActiveJob = {
+  id: number;
+  abort: AbortController;
+  source: MemoryGraphSource;
+  graph?: MemoryGraphOverviewPayload;
+  byId?: Map<string, MemoryGraphNode>;
+  port?: MessagePort;
+  acknowledgements: Map<number, (active: boolean) => void>;
+};
+
+export function createMemoryGraphDataController(post: PostResponse, options: { fetch?: typeof fetch; origin?: string; now?: () => number } = {}) {
+  const fetchGraph = options.fetch ?? globalThis.fetch.bind(globalThis);
+  const origin = options.origin ?? globalThis.location?.origin ?? "http://localhost";
+  const now = options.now ?? (() => performance.now());
+  let active: ActiveJob | null = null;
+  const current = (job: ActiveJob) => active === job && !job.abort.signal.aborted;
+
+  function cancel() {
+    if (!active) return;
+    active.abort.abort();
+    active.port?.close();
+    for (const resolve of active.acknowledgements.values()) resolve(false);
+    active.acknowledgements.clear();
+    active = null;
+  }
+
+  async function fetchJson(url: string, job: ActiveJob, timings?: MemoryGraphTimings): Promise<{ value: unknown; bytes: number }> {
+    const address = new URL(url, origin);
+    const permitted = address.pathname === "/api/admin/memory/graph/overview" || /^\/api\/admin\/memory\/nodes\/[^/]+$/.test(address.pathname);
+    if (address.origin !== origin || !permitted) throw new GraphDataError("Memory data must be loaded from this instance.", undefined, "INVALID_MEMORY_SOURCE");
+    const started = now();
+    const response = await fetchGraph(address.href, { credentials: "same-origin", cache: "no-store", signal: job.abort.signal });
+    const fetched = now();
+    const raw = await response.text();
+    const read = now();
+    let value: unknown;
+    try { value = JSON.parse(raw); } catch { throw new GraphDataError(response.ok ? "The memory response was not valid JSON." : `Memory request failed (${response.status}).`, response.status, "MEMORY_RESPONSE_INVALID"); }
+    if (!response.ok) {
+      const error = (value as { error?: { message?: string; code?: string; requestId?: string } })?.error;
+      throw new GraphDataError(error?.message ?? `Memory request failed (${response.status}).`, response.status, error?.code, error?.requestId);
+    }
+    if (timings) { timings.fetchMs = fetched - started; timings.readMs = read - fetched; timings.parseMs = now() - read; }
+    return { value, bytes: encoder.encode(raw).byteLength };
+  }
+
+  async function sendBatch(job: ActiveJob, message: Extract<MemoryGraphDataResponse, { type: "nodes" | "edges" }>): Promise<boolean> {
+    if (!current(job)) return false;
+    const acknowledgement = new Promise<boolean>(resolve => job.acknowledgements.set(message.sequence, resolve));
+    post(message);
+    return acknowledgement;
+  }
+
+  async function load(job: ActiveJob) {
+    const started = now();
+    const timings: MemoryGraphTimings = {};
+    let value: unknown, decodedBytes: number;
+    if (job.source.kind === "api") {
+      const loaded = await fetchJson(job.source.url, job, timings);
+      value = (loaded.value as { data?: unknown })?.data;
+      decodedBytes = loaded.bytes;
+    } else {
+      const generated = now();
+      value = job.source.kind === "synthetic"
+        ? syntheticMemoryOverview(createSyntheticMemoryGraph(job.source.size, job.source.seed), job.source.query)
+        : job.source.data;
+      timings.generateMs = now() - generated;
+      // This serializes the same rich domain fields as the real response, in this worker.
+      const serialized = now();
+      decodedBytes = encoder.encode(JSON.stringify({ data: value })).byteLength;
+      timings.serializeMs = now() - serialized;
+    }
+    if (!current(job)) return;
+    const validating = now();
+    const graph = memoryGraphOverviewPayloadSchema.parse(value);
+    assertMemoryGraphReferences(graph);
+    timings.validateMs = now() - validating;
+    job.graph = graph;
+    job.byId = new Map(graph.nodes.map(node => [node.id, node]));
+    const preparingAtlas = now();
+    const atlas = createMemoryAtlas(graph.nodes, graph.edges, false);
+    timings.atlasMs = now() - preparingAtlas;
+    const preparing = now();
+    const scene = prepareMemoryGraphScene(atlas);
+    timings.prepareMs = now() - preparing;
+    if (!current(job)) return;
+    const { nodes: _nodes, edges: _edges, ...overview } = graph;
+    post({ type: "meta", jobId: job.id, overview, atlas: { groups: atlas.groups, topics: atlas.topics, explicitCount: atlas.explicitCount, semanticCount: atlas.semanticCount }, nodeCount: atlas.nodes.length, edgeCount: atlas.edges.length, memoryCount: atlas.nodes.filter(node => node.type === "MEMORY").length, sourceLinkCount: atlas.edges.filter(edge => edge.type === "CONTAINS" || edge.type === "DERIVED_FROM").length, decodedBytes, timings: { ...timings } });
+    if (job.port) {
+      const request: Memory3DLayoutRequest = {
+        type: "layout", jobId: job.id,
+        nodes: atlas.nodes.map(({ id, type, label, sourcePath }) => ({ id, type, label, sourcePath })),
+        edges: atlas.edges.map(({ id, source, target, type }) => ({ id, source, target, type }))
+      };
+      job.port.postMessage(request);
+    }
+    const sending = now();
+    let sequence = 0;
+    for (let offset = 0; offset < atlas.nodes.length; offset += NODE_BATCH_SIZE) {
+      const nodes = atlas.nodes.slice(offset, offset + NODE_BATCH_SIZE);
+      if (!await sendBatch(job, { type: "nodes", jobId: job.id, sequence: sequence++, offset, nodes, atlasPositions: nodes.map(node => [node.id, atlas.positions.get(node.id)!]) })) return;
+    }
+    for (let offset = 0; offset < atlas.edges.length; offset += EDGE_BATCH_SIZE) {
+      if (!await sendBatch(job, { type: "edges", jobId: job.id, sequence: sequence++, offset, edges: atlas.edges.slice(offset, offset + EDGE_BATCH_SIZE) })) return;
+    }
+    if (!current(job)) return;
+    timings.sendMs = now() - sending;
+    timings.totalMs = now() - started;
+    post({ type: "prepared", jobId: job.id, scene, decodedBytes, timings }, memoryGraphSceneTransfers(scene));
+    post({ type: "complete", jobId: job.id });
+  }
+
+  async function detail(job: ActiveJob, nodeId: string, detailRequestId?: number) {
+    if (!job.graph || !job.byId) throw new GraphDataError("The memory graph is still loading.", undefined, "MEMORY_GRAPH_LOADING");
+    let result: MemoryGraphNodeDetail;
+    if (job.source.kind === "api") {
+      const loaded = await fetchJson(`/api/admin/memory/nodes/${encodeURIComponent(nodeId)}`, job);
+      result = memoryGraphNodeDetailSchema.parse(loaded.value);
+    } else {
+      const node = job.byId.get(nodeId);
+      if (!node) throw new GraphDataError("Memory node not found.", 404, "NOT_FOUND");
+      const relatedEdges: MemoryGraphEdge[] = [];
+      const ids = new Set<string>();
+      for (const edge of job.graph.edges) if (edge.source === nodeId || edge.target === nodeId) {
+        relatedEdges.push(edge); ids.add(edge.source); ids.add(edge.target);
+        if (relatedEdges.length >= 1000) break;
+      }
+      ids.delete(nodeId);
+      result = memoryGraphNodeDetailSchema.parse({ node, record: null, relatedNodes: [...ids].slice(0, 500).map(id => job.byId!.get(id)!), relatedEdges, issues: [] });
+    }
+    if (current(job)) post({ type: "detail", jobId: job.id, nodeId, detail: result, detailRequestId });
+  }
+
+  function report(job: ActiveJob, error: unknown, detailRequestId?: number) {
+    if (!current(job)) return;
+    const value = error as Partial<GraphDataError>;
+    post({ type: "error", jobId: job.id, message: error instanceof Error ? error.message : String(error), status: value.status, code: value.code, requestId: value.requestId, ...(detailRequestId === undefined ? {} : { detailRequestId }) });
+  }
+
+  async function handle(message: MemoryGraphDataRequest): Promise<void> {
+    if (message.type === "load") {
+      cancel();
+      const job: ActiveJob = { id: message.jobId, abort: new AbortController(), source: message.source, port: message.layoutPort, acknowledgements: new Map() };
+      active = job;
+      try { await load(job); } catch (error) { report(job, error); }
+    } else if (message.type === "ack") {
+      if (active?.id !== message.jobId) return;
+      const resolve = active.acknowledgements.get(message.sequence);
+      active.acknowledgements.delete(message.sequence);
+      resolve?.(true);
+    } else if (active?.id === message.jobId) {
+      const job = active;
+      try { await detail(job, message.nodeId, message.detailRequestId); } catch (error) { report(job, error, message.detailRequestId); }
+    }
+  }
+  return { handle, cancel };
+}
