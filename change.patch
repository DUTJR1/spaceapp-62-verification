index 0000000..c5f18f7
--- /dev/null
+++ b/apps/web/src/demo/synthetic-memory-graph.ts
@@ -0,0 +1,103 @@
+import type { MemoryGraphEdge, MemoryGraphNode, MemoryGraphPayload } from "@space/contracts";
+
+/** Pure fixture generator. Large instances must be generated in the memory data worker. */
+export const SYNTHETIC_MEMORY_GRAPH_SEED = 622026;
+export type SyntheticMemoryGraphSize = 2000 | 10000 | 50000;
+
+export function syntheticMemoryGraphSizeFromSearch(search: string): SyntheticMemoryGraphSize | null {
+  const value = new URLSearchParams(search).get("demoGraphSize");
+  return value === "2000" ? 2000 : value === "10000" ? 10000 : value === "50000" ? 50000 : null;
+}
+
+function randomFromSeed(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state += 0x6d2b79f5;
+    let value = state;
+    value = Math.imul(value ^ (value >>> 15), value | 1);
+    value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
+    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function createSyntheticMemoryGraph(
+  size: SyntheticMemoryGraphSize,
+  seed = SYNTHETIC_MEMORY_GRAPH_SEED
+): MemoryGraphPayload {
+  if (size !== 2000 && size !== 10000 && size !== 50000) throw new RangeError("Synthetic graph size must be 2000, 10000 or 50000.");
+  const random = randomFromSeed(seed);
+  const nodes: MemoryGraphNode[] = [];
+  const edges: MemoryGraphEdge[] = [];
+  const memories: MemoryGraphNode[] = [];
+  const sources: MemoryGraphNode[] = [];
+  const months: string[] = [];
+  // sourceCount means actual canonical source files and its existing contract
+  // permits at most 24. Keep small fixtures byte-for-byte stable; use fewer,
+  // larger real source clusters for the 50k fixture instead of clamping counts.
+  const clusterSize = Math.max(500, Math.ceil(size / 24));
+  for (let index = 0; index < size; index++) {
+    const cluster = Math.floor(index / clusterSize);
+    const source = index % clusterSize === 0;
+    const monthIndex = Math.max(0, cluster - 1);
+    const month = `${2020 + Math.floor(monthIndex / 12)}-${String(monthIndex % 12 + 1).padStart(2, "0")}`;
+    const path = cluster === 0 ? "/demo/synthetic/space.md" : `/demo/synthetic/space_memory_${month}.md`;
+    const centerX = (cluster % 10 - 4.5) * 60;
+    const centerY = (Math.floor(cluster / 10) - 4.5) * 60;
+    const x = index === 0 ? 0 : Math.round((centerX + (random() - 0.5) * 40) * 1000) / 1000;
+    const y = index === 0 ? 0 : Math.round((centerY + (random() - 0.5) * 40) * 1000) / 1000;
+    const id = index === 0 ? "source:synthetic-root" : `${source ? "source" : "memory"}:synthetic-${String(index).padStart(6, "0")}`;
+    const node: MemoryGraphNode = {
+      id,
+      type: source ? "SOURCE" : "MEMORY",
+      label: source ? (index === 0 ? "space.md" : `space_memory_${month}.md`) : `Synthetic memory ${String(index).padStart(6, "0")}`,
+      sourcePath: path,
+      recordId: source ? null : id,
+      position: { clustered: { x, y }, relations: { x, y } }
+    };
+    nodes.push(node);
+    if (source) {
+      if (sources.length) {
+        edges.push({ id: `edge:synthetic-source-${index}`, type: "DERIVED_FROM", source: sources[sources.length - 1]!.id, target: id });
+        months.push(month);
+      }
+      sources.push(node);
+    } else {
+      memories.push(node);
