+import "./memory-graph-worker-csp.js";
+import { createMemoryGraphDataController } from "./memory-graph-data-core.js";
+import type { MemoryGraphDataRequest, MemoryGraphDataResponse } from "./memory-graph-scene.js";
+
+const scope = self as unknown as {
+  postMessage(message: MemoryGraphDataResponse, transfers?: Transferable[]): void;
+  onmessage: ((event: MessageEvent<MemoryGraphDataRequest>) => void) | null;
+};
+const controller = createMemoryGraphDataController((message, transfers) => scope.postMessage(message, transfers));
+scope.onmessage = event => { void controller.handle(event.data); };
diff --git a/apps/web/src/features/memory-workspace/memory-graph-labels.ts b/apps/web/src/features/memory-workspace/memory-graph-labels.ts
