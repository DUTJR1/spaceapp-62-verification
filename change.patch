+        const x = p.x - centerX, y = p.y - centerY, z = p.z - centerZ;
+        xx += x * x; yy += y * y; zz += z * z; xy += x * y; xz += x * z; yz += y * z;
+      }
+      const determinant = xx * yy * zz + 2 * xy * xz * yz - xx * yz * yz - yy * xz * xz - zz * xy * xy;
+      const volumeRatio = count < 4 ? 0 : Math.max(0, determinant / Math.max(1e-12, ((xx + yy + zz) / 3) ** 3));
+      return { xyz, extent, volumeRatio };
+    },
+    toMap(): Map<string, MemoryPoint3D> { return new Map(ordered.map((node, i) => [node.id, { ...points[i]! }])); },
+    diagnostics() { return { initializationMs, lastStepMs, maxCellOccupancy, pairInteractions, aggregateInteractions }; }
+  };
+}
+
+/** Synchronous compatibility entry point for existing small graph consumers. */
+export function layoutMemoryNetwork3D(nodes: MemoryGraphNode[], edges: MemoryGraphEdge[]): Map<string, MemoryPoint3D> {
+  const simulation = createMemoryNetwork3DSimulation(nodes, edges);
+  simulation.step(simulation.totalIterations);
+  return simulation.toMap();
 }
 
