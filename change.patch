@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vitest";
+import { memoryGraphEdgeSchema, memoryGraphNodeSchema, memoryGraphOverviewPayloadSchema } from "@space/contracts";
+import { createSyntheticMemoryGraph, syntheticMemoryGraphSizeFromSearch, SYNTHETIC_MEMORY_GRAPH_SEED } from "../src/demo/synthetic-memory-graph.js";
+
+describe("synthetic memory preflight", () => {
+  it("requires an explicit supported query and keeps the ordinary demo path by default", () => {
+    for (const query of ["", "?demoGraphSize=7", "?demoGraphSize=999999", "?demoGraphSize=50000x"]) expect(syntheticMemoryGraphSizeFromSearch(query)).toBeNull();
+    expect(syntheticMemoryGraphSizeFromSearch("?demoGraphSize=2000")).toBe(2000);
+    expect(syntheticMemoryGraphSizeFromSearch("?demoGraphSize=10000")).toBe(10000);
+    expect(syntheticMemoryGraphSizeFromSearch("?demoGraphSize=50000")).toBe(50000);
+  });
+
+  it("creates repeatable domain-valid small graphs with exact budgets and valid unique edges", () => {
+    const graph = createSyntheticMemoryGraph(2000);
+    expect(graph).toEqual(createSyntheticMemoryGraph(2000, SYNTHETIC_MEMORY_GRAPH_SEED));
+    expect(graph.nodes).toHaveLength(2000);
+    expect(graph.edges).toHaveLength(6000);
+    expect(graph.summary).toMatchObject({ nodeCount: 2000, edgeCount: 6000, sourceCount: 4, recordCount: 1996 });
+    const ids = new Set(graph.nodes.map(node => node.id));
+    expect(ids.size).toBe(2000);
+    const edgeIds = new Set<string>();
+    const pairs = new Set<string>();
+    for (const node of graph.nodes) expect(memoryGraphNodeSchema.safeParse(node).success).toBe(true);
+    for (const edge of graph.edges) {
+      expect(memoryGraphEdgeSchema.safeParse(edge).success).toBe(true);
+      expect(ids.has(edge.source) && ids.has(edge.target)).toBe(true);
+      expect(edge.source).not.toBe(edge.target);
+      edgeIds.add(edge.id);
+      pairs.add([edge.source, edge.target].sort().join("|"));
+    }
+    expect(edgeIds.size).toBe(6000);
+    expect(pairs.size).toBe(6000);
+    expect(graph.nodes[0]).toMatchObject({ type: "SOURCE", label: "space.md", position: { clustered: { x: 0, y: 0 }, relations: { x: 0, y: 0 } } });
+    expect(graph.months).toEqual(["2020-01", "2020-02", "2020-03"]);
+  });
+
+  it("validates the entire 50k rich overview with actual source counts inside the existing domain bound", () => {
+    const graph = createSyntheticMemoryGraph(50000);
+    const overview = memoryGraphOverviewPayloadSchema.parse({ ...graph, totalMatchingNodes: graph.nodes.length, totalMatchingEdges: graph.edges.length, truncated: false });
+    expect(overview.nodes).toHaveLength(50000);
+    expect(overview.edges).toHaveLength(150000);
+    const sources = overview.nodes.filter(node => node.type === "SOURCE");
+    expect(sources).toHaveLength(24);
+    expect(new Set(overview.nodes.map(node => node.sourcePath)).size).toBe(24);
+    expect(overview.summary).toMatchObject({ sourceCount: 24, recordCount: 49976, nodeCount: 50000, edgeCount: 150000 });
+    expect(overview.months).toHaveLength(23);
+    expect(overview.nodes[0]).toMatchObject({ type: "SOURCE", label: "space.md", position: { relations: { x: 0, y: 0 } } });
+  }, 30_000);
+});
