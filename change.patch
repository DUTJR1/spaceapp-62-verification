+import type { ListMemoryGraphOverviewQuery } from "@space/contracts";
+
+export type MemoryGraphOverviewQuery = Partial<ListMemoryGraphOverviewQuery>;
+export type SyntheticMemoryGraphSize = 2000 | 10000 | 50000;
+
+export type { GraphSource } from "./memory-graph-scene.js";
+
+export function memoryGraphOverviewUrl(query: MemoryGraphOverviewQuery = {}): string {
+  const params = new URLSearchParams();
+  for (const key of ["q", "nodeType", "scope", "roomId", "sourcePath", "lifecycleStatus", "month", "relationMode", "limit"] as const) {
+    const value = query[key];
+    if (value !== undefined) params.set(key, String(value));
+  }
+  const suffix = params.toString();
+  return `/api/admin/memory/graph/overview${suffix ? `?${suffix}` : ""}`;
+}
diff --git a/apps/web/src/features/memory-workspace/memory-graph-data.worker.ts b/apps/web/src/features/memory-workspace/memory-graph-data.worker.ts
