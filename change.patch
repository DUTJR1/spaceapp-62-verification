+  }, []);
+  useEffect(() => { redrawRef.current(); }, [nodes, edges, positions, coordinates, showTitles, selectedNodeId]);
+  return <div className="memory-3d-surface"><canvas ref={canvasRef} tabIndex={0} role="application" aria-label="3D memory graph. Drag or use arrow keys to rotate 360 degrees. Scroll or pinch to zoom. Click a node to open." aria-busy={loading} data-titles-visible={showTitles} data-layout-volume={volumeRatio.toFixed(4)} /><span className="memory-3d-hint">Drag to rotate 360° · Scroll or pinch to zoom · Click to explore</span></div>;
+}
+
+/** A separate 2D canvas is required: a WebGL canvas cannot acquire a 2D context. */
+export function MemoryGraph3DCanvasFallback(props: Parameters<typeof MemoryGraph3DCanvas>[0]) {
+  const bounded = useMemo(() => {
+    const nodes = props.nodes.slice(0, 2000);
+    const ids = new Set(nodes.map(node => node.id));
+    const edges = props.edges.filter(edge => ids.has(edge.source) && ids.has(edge.target)).slice(0, 6000);
+    const positions = new Map(nodes.flatMap(node => {
+      const position = props.positions.get(node.id);
+      return position ? [[node.id, position] as const] : [];
+    }));
+    const coordinates = new Map(nodes.flatMap(node => {
+      const coordinate = props.coordinates.get(node.id);
+      return coordinate ? [[node.id, coordinate] as const] : [];
+    }));
+    return { nodes, edges, positions, coordinates };
+  }, [props.nodes, props.edges, props.positions, props.coordinates]);
+  return <MemoryGraph3DCanvas {...props} {...bounded} />;
+}
